# --- Banco de dados (PostgreSQL) ---
DATABASE_URL="postgresql://ibjt:ibjt123@localhost:5434/ibjt?schema=public"

# --- JWT ---
JWT_ACCESS_SECRET="troque-por-um-segredo-forte"
JWT_REFRESH_SECRET="troque-por-outro-segredo-forte"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# --- HTTP ---
PORT=3000
CORS_ORIGIN="http://localhost:3001"

# --- Armazenamento de relatórios (PDF) ---
# local | s3 (placeholder)
STORAGE_PROVIDER="local"
STORAGE_LOCAL_DIR="./storage/reports"
PUBLIC_BASE_URL="http://localhost:3000"

# --- Seed (usuário ADMIN inicial) ---
ADMIN_SEED_EMAIL="admin@ibjt.com.br"
ADMIN_SEED_PASSWORD="Admin@123"
ADMIN_SEED_NOME="Administrador"